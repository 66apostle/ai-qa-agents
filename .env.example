# Copy this file to .env and fill in real values. NEVER commit .env.
#
# Qase MCP server reads this token. Get yours at:
#   https://app.qase.io  →  Settings  →  API tokens
QASE_API_TOKEN=your-qase-api-token-here

# Atlassian (Jira/Confluence) does NOT use a token here.
# The atlassian MCP server authenticates via OAuth on first use.
# The bundled jira/confluence/investigate skills authenticate via ~/.netrc:
#   machine your-org.atlassian.net login <email> password <api-token>
